using {{Solution}}.Domain.Entities;
using Microsoft.EntityFrameworkCore;
using Microsoft.EntityFrameworkCore.Metadata.Builders;

namespace {{Solution}}.Persistence.Configurations;

public class {{Entity}}Configuration : IEntityTypeConfiguration<{{Entity}}>
{
    public void Configure(EntityTypeBuilder<{{Entity}}> builder)
    {
        builder.ToTable("{{Entities}}");
        builder.HasKey(x => x.Id);
        builder.Property(x => x.Id).ValueGeneratedOnAdd();

        // PROPERTIES — constraints must use the same constants as the validators.
        builder.Property(x => x.Name).IsRequired().HasMaxLength({{Entity}}.NameMaxLength);

        // Optional seed data — fixed GUIDs only, never Guid.NewGuid().
        // builder.HasData(new {{Entity}} { Id = new Guid("00000000-0000-0000-0000-000000000001"), Name = "..." });
    }
}
